# Copy to docker-dev/.env (git-ignored). Docker Compose reads it when run from this folder.

# Containers and volumes are named <project>-web-1, <project>_pgdata, ... Give each project its own name.
COMPOSE_PROJECT_NAME=rails-vue-dev

# Host ports (change them if something on your machine already uses them).
RAILS_PORT=3000
VITE_PORT=5173

# Linux only: your user ID (`id -u`), so files the containers create stay yours.
# USER_UID=1000
