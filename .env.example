# Copy to .env in the repository root (git-ignored). Docker Compose reads it automatically,
# which covers the dev container and bin/docker. For the native setup, export these in your shell instead.

# Host ports for the dev container (change them if something on your machine already uses them).
RAILS_PORT=3000
VITE_PORT=5173

# Native setup only: host ports for the Postgres/Redis containers and how Rails reaches them.
DATABASE_PORT=5432
REDIS_PORT=6379
# DATABASE_HOST=localhost
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=app_development
# REDIS_URL=redis://localhost:6379/0
