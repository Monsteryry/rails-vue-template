#!/usr/bin/env bash
# Run Rails API and Vite dev server together; Ctrl+C stops both.
set -euo pipefail
cd "$(dirname "$0")/.."

RAILS_PORT="${RAILS_PORT:-3000}"
export VITE_API_PROXY_TARGET="${VITE_API_PROXY_TARGET:-http://localhost:$RAILS_PORT}"

docker compose up -d --wait db

trap 'kill 0' EXIT
(cd backend && bin/rails server -p "$RAILS_PORT") &
(cd frontend && npm run dev) &
wait
